# IPO Radar - Environment Configuration
# Copy this file to .env and fill in your values.

# 飞书 (Feishu) Webhook notifications (optional)
# Setup: 飞书群 → 设置 → 群机器人 → 添加自定义机器人 → 复制 Webhook 地址
FEISHU_WEBHOOK_URL=

# Watchlist (comma-separated tickers, overrides default)
# WATCHLIST=CAVA,ARM,BIRK,CART,KPLT

# Ollama host (for Docker, set to http://ollama:11434)
# OLLAMA_HOST=http://localhost:11434
