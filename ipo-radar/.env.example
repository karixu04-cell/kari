# IPO Radar - Environment Configuration
# Copy this file to .env and fill in your values.
#
#   cp .env.example .env

# ------------------------------------------------------------------
# Feishu (飞书) Webhook — signal notifications
# Setup: 飞书群 → 设置 → 群机器人 → 添加自定义机器人 → 复制 Webhook 地址
# ------------------------------------------------------------------
FEISHU_WEBHOOK_URL=

# ------------------------------------------------------------------
# Watchlist (comma-separated tickers, overrides default)
# Default: CAVA,ARM,BIRK,CART,KPLT
# ------------------------------------------------------------------
# WATCHLIST=CAVA,ARM,BIRK,CART,KPLT

# ------------------------------------------------------------------
# Ollama — local LLM for sentiment analysis (optional)
# For Docker:  http://ipo-radar-ollama:11434
# For local:   http://localhost:11434
# ------------------------------------------------------------------
# OLLAMA_HOST=http://ipo-radar-ollama:11434

# ------------------------------------------------------------------
# Dashboard port (default 8501)
# ------------------------------------------------------------------
# DASHBOARD_PORT=8501
